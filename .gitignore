# Local environment — and here that is not a tidiness rule.
#
# `.env` in this package holds live credentials: an Azure DevOps personal access token, an
# Anthropic API key, a storage account connection string, the JWT signing key and the session
# secret. A commit is permanent and a push is public, so a key that lands here is a key that must
# be rotated, not deleted. `.env.example` is committed in its place: it documents which variables
# exist without carrying any machine's values.
.env
.env.*
!.env.example

# Dependencies — restored by `npm install`.
node_modules/

# Build output — regenerated by `npm run build`.
dist/
build/
*.tsbuildinfo

# Database and state dumps taken before destructive work. These contain real project data and
# occasionally credentials copied out of the database; they are deliberately local-only.
backup/

# Test and tooling output
coverage/
.nyc_output/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Keys and certificates, in case one is ever written here by hand
*.pem
*.key
*.pfx
*.p12

# Editor and OS noise
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
