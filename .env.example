# Agentic SDLC Orchestrator — API (NestJS) environment example.
# Copy to `.env` for local development. NEVER commit a real `.env`.
# Secrets (*_KEY, *_SECRET, *_PAT, *_URI credentials) resolve from Azure Key Vault in cloud
# via Workload Identity — the values below are DUMMY PLACEHOLDERS only.

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3000

# --- Persistence (secret; from Key Vault in cloud) -------------------------
MONGODB_URI=mongodb://localhost:27017/orchestrator

# --- Auth (secrets; from Key Vault in cloud) -------------------------------
JWT_SIGNING_KEY=replace-with-strong-random-value
SESSION_SECRET=replace-with-strong-random-value
JWT_ACCESS_TTL_SECONDS=900
SESSION_TTL=1209600

# --- Azure -----------------------------------------------------------------
KEY_VAULT_URI=https://your-keyvault.vault.azure.net
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
BLOB_ACCOUNT_URL=https://youraccount.blob.core.windows.net
BLOB_CONTAINER=orchestrator-artifacts

# --- Azure DevOps (PAT is a secret; from Key Vault in cloud) ---------------
ADO_ORG_URL=https://dev.azure.com/your-org
ADO_PAT=replace-with-scoped-pat

# --- Kubernetes / worker image ---------------------------------------------
K8S_NAMESPACE=ai-jobs
ACR_LOGIN_SERVER=youracr.azurecr.io
WORKER_IMAGE_TAG=latest

# --- Run cost / safety hard-stops ------------------------------------------
MAX_RUN_TOKENS=1000000
MAX_RUN_COST=25

# --- Lease / heartbeat -----------------------------------------------------
RUN_LEASE_TTL_MS=120000
RUN_HEARTBEAT_MS=30000
# Scheduler interval for reclaiming expired job leases (retry-not-resume). Phase 2.
RUN_RECLAIM_INTERVAL_MS=60000

# --- Developer execution (Phase 2) -----------------------------------------
# Azure Repos branch developer pods commit to (no PR gate in Milestone 1).
DEVELOPER_BRANCH=develop
# Git identity for developer commits.
GIT_AUTHOR_NAME=Agentic SDLC Orchestrator               
GIT_AUTHOR_EMAIL=agentic-sdlc@noventiqai.com
# In-pod path to the Azure DevOps MCP config the Developer session loads (--mcp-config).
ADO_MCP_CONFIG=/app/ado-mcp.json
# Azure Repos push credentials (secret; from Key Vault in cloud). Format: <user>:<pat> or pat.
GIT_CREDS=replace-with-repo-credentials
# Claude auth mode: 'subscription' (Claude Code login) or 'api' (ANTHROPIC_API_KEY required).
CLAUDE_AUTH_MODE=subscription
# ANTHROPIC_API_KEY=sk-... # required only when CLAUDE_AUTH_MODE=api (secret; from Key Vault)

# --- Orchestration scheduler (Phase 2.1) -----------------------------------
# Master on/off (pause/stop) switch for the autonomous dispatch scheduler.
ORCHESTRATION_ENABLED=false
# Scheduler tick interval in ms (~300000 = 5 min).
ORCHESTRATION_INTERVAL_MS=300000
# Global cap on concurrently dispatched pods; the scheduler dispatches only below it.
MAX_CONCURRENT_RUNS=5
# Which legs the loop drives, comma-separated (e.g. developer,qa). QA leg needs Phase 3.
ORCHESTRATION_ROLES=developer